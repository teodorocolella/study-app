# Copy this file to client/.env.local for local development.
# Optional — leave unset to disable analytics entirely (e.g. in local dev).
# Vite bakes VITE_-prefixed vars into the build at build time, so on Render
# this must be set as an environment variable on the Web Service (same
# place as the other env vars) before the build runs.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
