# Copy this file to server/.env and fill in real values. Never commit server/.env.

# Anthropic API key used by the backend for AI features (flashcard generation,
# tutor chat, note summarization, explain-differently). Never exposed to the frontend.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Postgres connection string (local dev instance or a hosted one, e.g. Neon/Render).
DATABASE_URL=postgresql://user:password@localhost:5432/study_app

# Long random strings used to sign JWTs. Generate with: openssl rand -base64 48
# Use two DIFFERENT values — access and refresh secrets must not match.
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

NODE_ENV=development
PORT=3001

# Only needed if client and server are ever deployed to different origins (CORS).
# Same-origin in the default single-service deployment, so this can stay unset.
CLIENT_ORIGIN=http://localhost:5173
