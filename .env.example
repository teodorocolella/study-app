# Copy this file to server/.env and fill in real values. Never commit server/.env.

# Anthropic API key used by the backend for AI features (flashcard generation,
# tutor chat, note summarization, explain-differently). Never exposed to the frontend.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Postgres connection string (local dev instance or a hosted one, e.g. Neon/Render).
DATABASE_URL=postgresql://user:password@localhost:5432/study_app

# Long random strings used to sign JWTs. Generate with: openssl rand -base64 48
# Use two DIFFERENT values — access and refresh secrets must not match.
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

NODE_ENV=development
PORT=3001

# Only needed if client and server are ever deployed to different origins (CORS).
# Same-origin in the default single-service deployment, so this can stay unset.
CLIENT_ORIGIN=http://localhost:5173

# --- Email reminders (optional) ---
# Daily "you have cards due" reminder emails. Leave unset to disable — the app
# works fine without them. Any SMTP provider works (Gmail app password, Resend
# SMTP, Mailgun, etc.).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Study Hub <you@gmail.com>"

# Public URL of the app, used for links inside reminder emails.
APP_URL=http://localhost:5173

# When the daily reminder job runs (cron syntax, server time). Default: 4pm daily.
REMINDER_CRON=0 16 * * *

# --- Social sign-in (optional) ---
# "Continue with Google/Microsoft" buttons appear only when a provider's id AND
# secret are both set. Create an OAuth app in each provider's console and set the
# redirect URI to <APP_URL>/api/auth/oauth/<provider>/callback, e.g.
#   http://localhost:5173/api/auth/oauth/google/callback   (local dev)
#   https://your-app.onrender.com/api/auth/oauth/google/callback   (production)
# Google: https://console.cloud.google.com/apis/credentials (OAuth client, type "Web").
# Microsoft: https://portal.azure.com → App registrations (redirect type "Web").
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx
# MICROSOFT_CLIENT_ID=xxxxx
# MICROSOFT_CLIENT_SECRET=xxxxx

# --- Object storage for images (optional) ---
# By default, images (card photos, occlusion images) are stored inline as data
# URLs in the database. Configure an S3-compatible bucket (Cloudflare R2, AWS S3)
# to store them as files instead — much kinder to the database at scale.
# Enabled only when bucket + keys + public URL are all set.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_REGION=auto
# S3_BUCKET=study-hub-images
# S3_ACCESS_KEY_ID=xxxxx
# S3_SECRET_ACCESS_KEY=xxxxx
# S3_PUBLIC_URL=https://pub-xxxxx.r2.dev   # public base URL for the bucket

# --- Push notifications (optional) ---
# Real browser/device notifications for new direct messages and study-group
# messages, even when Study Hub isn't open. Enabled only when both VAPID keys
# are set. Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=xxxxx
# VAPID_PRIVATE_KEY=xxxxx
# VAPID_SUBJECT=mailto:you@example.com
