datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  displayName    String
  avatarUrl      String?        @db.Text
  hasOnboarded   Boolean        @default(false)
  gradeLevel     Int? // 1-12 = school grade, 13 = college/other; null = not set
  gradeUpdatedAt DateTime? // when gradeLevel was last set — drives yearly auto-advance
  createdAt      DateTime       @default(now())

  classFolders  ClassFolder[]
  refreshTokens RefreshToken[]
  cardProgress  CardProgress[]
  reviewLogs    ReviewLog[]
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  exerciseAttempts ExerciseAttempt[]
  groupMemberships GroupMember[]
  groupMessages    GroupMessage[]
  pushSubscriptions PushSubscription[]
}

// A registered browser/device push endpoint (Web Push). One row per
// browser/device the user has enabled notifications on.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
}

// A multi-person study group with a shared chat and shared resources.
model StudyGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members  GroupMember[]
  messages GroupMessage[]
}

model GroupMember {
  id         String     @id @default(cuid())
  groupId    String
  group      StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String     @default("member") // "owner" | "member"
  lastReadAt DateTime   @default(now())
  joinedAt   DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

// Group chat message; shared notes/decks/quizzes ride along as JSON snapshots.
model GroupMessage {
  id             String     @id @default(cuid())
  groupId        String
  group          StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String?    @db.Text
  attachmentType String? // "note" | "deck" | "exercise_set"
  attachmentJson String?    @db.Text
  createdAt      DateTime   @default(now())

  @@index([groupId, createdAt])
}

// Direct messages between students. Shared notes/decks travel as JSON
// snapshots so the recipient never reads another user's live data.
model Message {
  id             String    @id @default(cuid())
  senderId       String
  sender         User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body           String?   @db.Text
  attachmentType String? // "note" | "deck"
  attachmentJson String?   @db.Text
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  @@index([recipientId, readAt])
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ClassFolder {
  id        String   @id @default(cuid())
  name      String
  colorTag  String?
  archived  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  notes        Note[]
  decks        Deck[]
  exerciseSets ExerciseSet[]
  folders      Folder[]

  @@index([userId])
}

// An optional grouping inside a class. Notes, decks, and quizzes can live at
// the class root (folderId null) or be filed into a folder.
model Folder {
  id            String      @id @default(cuid())
  name          String
  archived      Boolean     @default(false)
  classFolderId String
  classFolder   ClassFolder @relation(fields: [classFolderId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  notes        Note[]
  decks        Deck[]
  exerciseSets ExerciseSet[]

  @@index([classFolderId])
}

// A practice quiz: a mixed bag of exercises (MCQ, true/false,
// fill-in-the-blank, AI-graded short answer) belonging to a class.
model ExerciseSet {
  id            String      @id @default(cuid())
  name          String
  colorTag      String?
  archived      Boolean     @default(false)
  classFolderId String
  classFolder   ClassFolder @relation(fields: [classFolderId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  exercises Exercise[]
  attempts  ExerciseAttempt[]

  @@index([classFolderId])
  @@index([folderId])
}

model Exercise {
  id          String      @id @default(cuid())
  setId       String
  set         ExerciseSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  type        String // "mcq" | "true_false" | "fill_blank" | "short_answer"
  prompt      String      @db.Text
  optionsJson String?     @db.Text // mcq only: JSON array of option strings
  answer      String      @db.Text // mcq: correct option text; true_false: "true"/"false"; fill_blank: expected text; short_answer: model answer
  explanation String?     @db.Text
  position    Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([setId])
}

// One completed run through a set (or a retry of missed questions).
model ExerciseAttempt {
  id          String      @id @default(cuid())
  setId       String
  set         ExerciseSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  resultsJson String      @db.Text // per-question grading detail
  createdAt   DateTime    @default(now())

  @@index([setId, userId, createdAt])
}

model Note {
  id            String      @id @default(cuid())
  title         String
  contentHtml   String      @db.Text
  aiSummary     String?     @db.Text
  colorTag      String?
  archived      Boolean     @default(false)
  classFolderId String
  classFolder   ClassFolder @relation(fields: [classFolderId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([classFolderId])
  @@index([folderId])
}

model Deck {
  id            String      @id @default(cuid())
  name          String
  colorTag      String?
  archived      Boolean     @default(false)
  classFolderId String
  classFolder   ClassFolder @relation(fields: [classFolderId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  cards         Flashcard[]

  @@index([classFolderId])
  @@index([folderId])
}

model Flashcard {
  id         String         @id @default(cuid())
  front      String         @db.Text
  back       String         @db.Text
  frontImage String?        @db.Text // optional photo on the front (data URL)
  backImage  String?        @db.Text // optional photo on the back (data URL)
  kind       String         @default("basic") // "basic" | "image_occlusion"
  occlusionsJson String?    @db.Text // image_occlusion: JSON array of {x,y,w,h,label} as % of image
  deckId     String
  deck       Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  progress   CardProgress[]

  @@index([deckId])
}

// Per-user-per-card SM-2 scheduling state.
model CardProgress {
  id             String    @id @default(cuid())
  cardId         String
  card           Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueDate        DateTime  @default(now())
  lastReviewedAt DateTime?

  @@unique([cardId, userId])
  @@index([userId, dueDate])
}

// Audit trail of every review — powers streak calculation and "studied today" stats.
model ReviewLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId     String
  grade      Int
  reviewedAt DateTime @default(now())

  @@index([userId, reviewedAt])
}
